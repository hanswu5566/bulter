// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  TENANT
  LANDLORD
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(TENANT)
  
  // 核心畫像數據 (Spec 01)
  baseProfile   Json?     // 基礎資料: { "phone": string, "occupation": string, "language": string }
  aiTags        Json?     // Butler 提取的生活標籤: { "tags": string[], "tagsWithWeight": { "tag": weight } }
  trustSummary  String?   @db.Text // AI 生成的信用推薦語
  
  accounts      Account[]
  sessions      Session[]
  listings      Listing[] @relation("LandlordListings")
  reports       InspectionReport[]
  appointments  Appointment[]
  listingStatuses UserListingStatus[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Listing {
  id            String    @id @default(cuid())
  title         String
  description   String?   @db.Text
  address       String
  price         Int
  currency      String    @default("TWD") // TWD, JPY
  isExpired     Boolean   @default(false) // 是否已下架
  images        String[]  // Array of GCS paths
  lat           Float?
  lng           Float?
  
  // 市場與設施標籤 (Spec 02)
  marketTags    Json?     // TW: { rent_subsidy: bool, ... }, JP: { reikin: int, ... }
  features      Json?     // 設施屬性: { elevator: bool, balcony: bool, appliances: string[], atmosphereTags: string[] }
  
  // 遷移與 AI 分析
  sourceUrl     String?   @unique
  rawScrapedData Json?    
  butlerInsight Json?     // AI 生成的亮點、風險與 Match Score 參考
  embedding     Unsupported("vector(768)")?
  
  landlordId    String?
  landlord      User?     @relation("LandlordListings", fields: [landlordId], references: [id])
  
  reports       InspectionReport[]
  appointments  Appointment[]
  userStatuses  UserListingStatus[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model UserListingStatus {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  isRemoved Boolean  @default(false) // 是否被用戶移除（隱藏）
  isSaved   Boolean  @default(false) // 是否被用戶收藏
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, listingId])
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  REJECTED
  VISITED
  CANCELLED
}

model Appointment {
  id          String        @id @default(cuid())
  tenantId    String
  landlordId  String
  listingId   String
  scheduledAt DateTime      // 預約的時段
  status      BookingStatus @default(REQUESTED)
  
  tenant      User          @relation(fields: [tenantId], references: [id])
  listing     Listing       @relation(fields: [listingId], references: [id])
  report      InspectionReport?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model InspectionReport {
  id            String      @id @default(cuid())
  appointmentId String?     @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  
  listingId     String
  listing       Listing     @relation(fields: [listingId], references: [id])
  
  tenantId      String
  tenant        User        @relation(fields: [tenantId], references: [id])
  
  checklistData Json?       // 結構化事實紀錄
  photos        String[]    // 異常存證照片路徑
  aiSummary     String?     @db.Text // Gemini 生成的實勘總結
  
  status        String      @default("IN_PROGRESS")
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}



model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}



// --- AI & Protection (Shield) ---
model RateLimit {
  id          String   @id @default(cuid())
  identifier  String   // User ID or IP
  action      String   // e.g., "AI_CHAT"
  timestamp   DateTime @default(now())

  @@index([identifier, action, timestamp])
}

model AiConversation {
  id          String      @id @default(cuid())
  userId      String?
  sessionId   String      @unique // Client-side generated UUID
  role        UserRole    @default(TENANT)
  currentStep Int         @default(0) // 0: Start, 1: Budget, 2: Region, etc.
  summary     String?     @db.Text
  messages    AiMessage[]
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
  @@index([sessionId])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String         // "user" | "assistant" | "system" | "tool"
  content        String         @db.Text
  toolCalls      Json?          // If the assistant called a tool
  createdAt      DateTime       @default(now())

  @@index([conversationId])
}
